<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TVTimeRecovery.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>8.0.29</RuntimeFrameworkVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DisableXbfLineInfo>true</DisableXbfLineInfo>
    <PathMap>$(MSBuildProjectDirectory)=/_/TVTimeRecovery.Windows</PathMap>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <TVTimeGeneratedContentRoot Condition="'$(TVTimeGeneratedContentRoot)' == ''">$(MSBuildProjectDirectory)</TVTimeGeneratedContentRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[2.2.0]" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.26100.4948]" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(TVTimeGeneratedContentRoot)\Assets\*.png" Condition="Exists('$(TVTimeGeneratedContentRoot)\Assets\StoreLogo.png')">
      <Link>Assets\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(TVTimeGeneratedContentRoot)\Notices\**\*" Condition="Exists('$(TVTimeGeneratedContentRoot)\Notices\MANIFEST.json')">
      <Link>Notices\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(TVTimeGeneratedContentRoot)\Helpers\tvtime-helper.exe')">
    <Content Include="$(TVTimeGeneratedContentRoot)\Helpers\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Helpers\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>Helpers\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
</Project>
